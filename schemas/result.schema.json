{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Behavioral Run Result",
  "type": "object",
  "required": ["variant", "cases"],
  "properties": {
    "variant": {"type": "string", "minLength": 1},
    "runtime": {"type": "string"},
    "model": {"type": "string"},
    "notes": {"type": "string"},
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "must_passed", "must_total", "must_not_violations", "completed", "observable_contributions"],
        "properties": {
          "id": {"type": "string"},
          "must_passed": {"type": "integer", "minimum": 0},
          "must_total": {"type": "integer", "minimum": 1},
          "must_not_violations": {"type": "integer", "minimum": 0},
          "completed": {"type": "boolean"},
          "unnecessary_steps": {"type": "integer", "minimum": 0, "default": 0},
          "observable_contributions": {"type": "array", "items": {"type": "string"}},
          "critical_failure": {"type": "boolean", "default": false},
          "notes": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}

