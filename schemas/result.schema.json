{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Auditable Behavioral Result Bundle",
  "type": "object",
  "required": ["version", "session_id", "variant", "subject_digest", "case_set_digest", "runtime", "model", "configuration_digest", "cases"],
  "properties": {
    "version": {"const": 2},
    "session_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "variant": {"type": "string", "minLength": 1},
    "subject_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "case_set_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "runtime": {"type": "string", "minLength": 1},
    "model": {"type": "string", "minLength": 1},
    "configuration_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "notes": {"type": "string"},
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "case_digest", "raw_output", "behavior_checks", "completed"],
        "properties": {
          "id": {"type": "string"},
          "case_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "raw_output": {"type": "string", "minLength": 1},
          "behavior_checks": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["behavior", "kind", "outcome", "evidence"],
              "properties": {
                "behavior": {"type": "string", "minLength": 1},
                "kind": {"enum": ["must", "must_not"]},
                "outcome": {"enum": ["pass", "fail", "inconclusive"]},
                "evidence": {"type": "string", "minLength": 1}
              },
              "additionalProperties": false
            }
          },
          "completed": {"type": "boolean"},
          "unnecessary_steps": {"type": "integer", "minimum": 0, "default": 0},
          "observable_contributions": {"type": "array", "items": {"type": "string"}, "default": []},
          "critical_failure": {"type": "boolean", "default": false},
          "notes": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
