{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Optimization Proposal",
  "type": "object",
  "required": ["version", "id", "action", "target", "evidence", "expected_improvement", "complexity_change", "regression_risk", "reject_when"],
  "properties": {
    "version": {"const": 1},
    "id": {"type": "string"},
    "action": {"enum": ["add", "strengthen", "reroute", "merge", "split", "demote", "delete"]},
    "target": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "evidence": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "expected_improvement": {"type": "string", "minLength": 1},
    "complexity_change": {"enum": ["decrease", "neutral", "increase"]},
    "regression_risk": {"type": "string", "minLength": 1},
    "affected_cases": {"type": "array", "items": {"type": "string"}, "default": []},
    "reject_when": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
